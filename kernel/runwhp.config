# Configuration of runwhp's guest kernel, as a fragment over allnoconfig:
# whatever is not named here is off, apart from the defaults allnoconfig keeps
# (core system calls and the like) and CPU vulnerability mitigations, which
# build.sh leaves at upstream's defaults. check-config.sh fails the build if a
# setting here does not survive into the final configuration, and full.config
# records that final configuration for review.
#
# Nothing is a module: runwhp's initramfs carries no modules.

# --- Identity --------------------------------------------------------------

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-runwhp"
# CONFIG_LOCALVERSION_AUTO is not set
# Fastest to decompress, which is most of the time before the kernel's clock
# starts.
CONFIG_KERNEL_LZ4=y
# CONFIG_MODULES is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- What runwhp's VMM needs to boot it --------------------------------------

# Hyper-V enlightenments: TSC and APIC timer frequencies, the TSC page
# clocksource. There is no VMBus.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_HYPERV=y
# CONFIG_HYPERV_VMBUS is not set
# CONFIG_KVM_GUEST is not set

CONFIG_SMP=y
CONFIG_X86_X2APIC=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_JUMP_LABEL=y
# Fixed addresses keep oops traces readable; the container is the only
# tenant of the guest.
# CONFIG_RANDOMIZE_BASE is not set

# Devices are declared in hardware-reduced ACPI tables. ACPICA wants PCI
# configuration space support even though runwhp boots with pci=off.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PNP=y
# CONFIG_EFI is not set

# The kernel console on COM1 (PNP0501).
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_PRINTK_TIME=y

# virtio-mmio devices (LNRO0005).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
# CONFIG_VIRTIO_PCI is not set

# runwhp's initramfs is an uncompressed cpio archive.
CONFIG_BLK_DEV_INITRD=y

# The wall clock comes from the VMM's CMOS stub, read by x86 platform code.
# CONFIG_RTC_CLASS is not set

# --- What runwhp-init needs --------------------------------------------------

CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
# overlayfs keeps opaque directories and whiteouts in trusted.* xattrs of its
# tmpfs upper layer.
CONFIG_TMPFS_XATTR=y
CONFIG_UNIX98_PTYS=y
CONFIG_INOTIFY_USER=y

# One read-only ext4 image per layer, under overlayfs.
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y

# Standard streams and the control channel.
CONFIG_VIRTIO_CONSOLE=y

# eth0, configured over rtnetlink.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# --- What containers commonly expect of a Linux host --------------------------

CONFIG_IA32_EMULATION=y
CONFIG_BINFMT_MISC=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUSE_FS=y
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# Namespaces and cgroups, for programs that build containers of their own.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y

# IPv6 sockets, even though runwhp's network carries only IPv4: servers such
# as nginx listen on [::] by default.
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y

# Netfilter, enough for Docker or Podman inside a container, with iptables
# over nftables or the legacy tables.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_MANGLE=y

# --- Built in now for work that is planned -----------------------------------

# Host file sharing: 9p or virtio-fs, over virtio or vsock.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_VIRTIO_FS=y

# Giving guest memory back to Windows.
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
